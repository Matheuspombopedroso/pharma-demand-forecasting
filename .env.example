# Environment variables read by src/pharma_forecast/config.py (all optional).
# The Python code does not load .env files itself: export these in your shell,
# or copy this file to .env, which docker-compose.yml passes to the container.
# No secrets are needed: everything runs locally.

# Where the synthetic CSV is written and read.
PF_DATA_PATH=data/consumption.csv
# MLflow backend store; SQLite is required for the Model Registry (aliases).
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# Where MLflow stores model files and reports.
PF_ARTIFACT_ROOT=mlartifacts
# MLflow experiment name.
PF_EXPERIMENT=pharma-demand-forecasting
# Ray Tune trial output (keep it short on Windows: 260-char path limit).
PF_RAY_RESULTS=ray_results
# Global seed for data generation and XGBoost.
PF_SEED=42
